/fonts/*
  Cache-Control: public, max-age=604800, immutable

# 页面引用的 js/css 都带 ?v= 版本号（改内容就 bump 一次，见 servers.html / admin.html），
# 所以可以放心长期 immutable：max-age=300 那版等于让每个访客每隔几分钟重新拉一次 43 KB 的
# servers.js，而本机这类走代理的链路单次要 2–26 秒 —— 这就是"清单加载很慢"的最大一项。
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# 静态兜底数据：镜像清单 + 仓库里那份签名清单快照（servers.js 的第二路取数）
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# HTML 给一个短 TTL + SWR：清单页的按钮/文案改动靠 ?v= 生效，不需要每次都回源
/*.html
  Cache-Control: public, max-age=120, stale-while-revalidate=600

# Pages 的"干净地址"不匹配上面那条 /*.html（/servers 就是 servers.html），于是它一直是
# max-age=0, must-revalidate —— 每次进入都回源一次，实测文档首字节 5.1 s。
/servers
  Cache-Control: public, max-age=120, stale-while-revalidate=600

/admin
  Cache-Control: public, max-age=120, stale-while-revalidate=600

/
  Cache-Control: public, max-age=120, stale-while-revalidate=600

# 关死「地址栏不安全」在本站的两个来路：
#   HSTS —— 浏览器记住后 Typed 域名直接走 https，不再出现 http 中间态（本站全资源 https，无风险）；
#   upgrade-insecure-requests —— 未来谁手滑放进 http 子资源也被浏览器当场升到 https。
# 清单里 http:// 游戏服的「不安全」是那台服务器自己的页面，由 servers.js 的 HTTP 徽标说明。
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: upgrade-insecure-requests
